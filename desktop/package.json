{
  "name": "medialab-portable",
  "version": "0.0.8",
  "description": "Portable YUV, Bayer RAW, HEIC, H.264 and H.265 diagnostic tool for Windows",
  "main": "src/main.cjs",
  "author": "MediaLab",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-ffmpeg.cjs",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.cjs",
    "start": "electron .",
    "dist": "node scripts/prepare-ffmpeg.cjs && electron-builder --win portable --x64 && node scripts/build-cached-portable.cjs"
  },
  "devDependencies": {
    "@ffprobe-installer/win32-x64": "5.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.medialab.portable",
    "productName": "MediaLab",
    "artifactName": "MediaLab-Portable-${version}.${ext}",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ffmpeg/bin/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "ffmpeg/bin/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      },
      {
        "from": "ffmpeg/LICENSE.txt",
        "to": "ffmpeg/LICENSE.txt"
      },
      {
        "from": "ffmpeg/GPL-3.0.txt",
        "to": "ffmpeg/GPL-3.0.txt"
      },
      {
        "from": "ffmpeg/build.json",
        "to": "ffmpeg/build.json"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "MediaLab-Portable-${version}.exe"
    }
  }
}
